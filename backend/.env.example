MONGO_URL=
DB_NAME=securesphere
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
USE_MOCK_SCANNER=true

SCAN_TIMEOUT_SECONDS=60
MAX_MANUAL_SCANS_PER_HOUR=20
MAX_RUNNING_SCANS_PER_USER=2
SCAN_CACHE_SECONDS=300

MAX_FAILED_LOGINS=5
MAX_FAILED_LOGINS_PER_IP=20
LOGIN_LOCK_MINUTES=15
SCORE_DROP_THRESHOLD=10
SCHEDULER_TZ=Asia/Kolkata
SCAN_HOUR=2

FRONTEND_URL=http://localhost:5173
RESET_TOKEN_MINUTES=30
MAX_RESET_REQUESTS_PER_HOUR=3
VERIFY_TOKEN_HOURS=24

# AI assistant (optional). Get a key at https://console.anthropic.com. Without it, simple built-in answers are used.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
MAX_ASSISTANT_MESSAGES_PER_HOUR=30

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Hosts that block SMTP (Render free plan): send through Brevo's web API instead (free, 300 emails/day).
# SMTP_FROM must be a verified sender in Brevo.
BREVO_API_KEY=
